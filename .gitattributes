* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
# Preserve measurement exports byte-for-byte, including original header whitespace.
examples/z_tape/data/raw_data.txt -text whitespace=-blank-at-eol
examples/synthetic/data.csv -text whitespace=cr-at-eol
# Published result snapshots and checksums must survive checkout byte-for-byte.
results/** -text whitespace=cr-at-eol
# Matplotlib path data intentionally contains trailing spaces; keep generated
# plots and large embedded arrays out of line-by-line source reviews.
results/**/*.svg -diff whitespace=-blank-at-eol,cr-at-eol
results/**/viewer.html -diff
results/**/sample_to_pixel.csv -diff
